# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of browser origins allowed to call the API.
# The frontend is plain static HTML, so also allow the file:// case
# by opening it through a static server (see README).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ── Database ─────────────────────────────────────────────
# Either give a full URL...
DATABASE_URL=postgres://opsts_app:opsts_dev_password@127.0.0.1:5432/opsts
# ...or the discrete parts (used only when DATABASE_URL is unset)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=opsts
PGUSER=opsts_app
PGPASSWORD=opsts_dev_password
PGSSL=false

# ── Auth ─────────────────────────────────────────────────
# MUST be replaced with a long random value in every real deployment.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=30

# ── Default administrator ────────────────────────────────
# Seeded ONCE, the first time the API starts against a database with
# no administrator in it. Never overwrites an existing account.
#
# Leaving these blank in development seeds the documented built-in
# credentials:
#     admin@opsts.local  /  Admin@OPSTS2026
#
# In PRODUCTION the built-in password is refused: set
# DEFAULT_ADMIN_PASSWORD explicitly, or create the first admin with
#     npm run create-admin -- --email you@school.edu --password '<strong>'
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_FIRST_NAME=
DEFAULT_ADMIN_LAST_NAME=
DEFAULT_ADMIN_STAFF_ID=

# ── Uploads ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ── Email (optional — omit and the API logs instead of sending) ──
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="OPSTS <no-reply@opsts.local>"
APP_URL=http://localhost:5500

# ── Zoom (optional — Server-to-Server OAuth app) ─────────
# Without these, meeting links fall back to a generated join URL.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
